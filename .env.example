# Red
EXPO_PUBLIC_CHAIN_ID=
EXPO_PUBLIC_RPC_URL=

# USDT de prueba del mercado de Aave en Sepolia (6 decimales)
EXPO_PUBLIC_USDT_ADDRESS=

# Fábrica en uso. Ver chanchito-contracts/DEPLOYMENTS.md
EXPO_PUBLIC_POOL_FACTORY_ADDRESS=
# Fábrica sobre Aave v3 real (hoy inutilizable: el tope de USDT está agotado)
EXPO_PUBLIC_AAVE_FACTORY_ADDRESS=
# Nombres de usuario y amistades
EXPO_PUBLIC_SOCIAL_REGISTRY_ADDRESS=

# WalletConnect / Reown — es público por diseño: viaja en el bundle
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Sólo para pruebas automatizadas: frena las animaciones en bucle para que las
# herramientas de UI de Android puedan leer la pantalla. DEJAR VACÍO en la demo.
EXPO_PUBLIC_REDUCE_MOTION=

# --- WDK gasless (EIP-7702) ---
# Bundler y paymaster. Candide sirve los dos en la misma URL.
# Sacá tu API key en https://dashboard.candide.dev
EXPO_PUBLIC_BUNDLER_URL=https://api.candide.dev/api/v3/11155111/TU_API_KEY
# Contrato de delegación EIP-7702, provisto por el paymaster.
EXPO_PUBLIC_DELEGATION_ADDRESS=0xe6Cae83BdE06E4c305530e199D7217f42808555B

# Dónde caen las comisiones de servicio. Si se deja vacío, la app no cobra.
EXPO_PUBLIC_TREASURY_ADDRESS=
